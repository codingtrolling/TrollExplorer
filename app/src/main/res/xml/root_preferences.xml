<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="File Browser Settings">
        <SwitchPreferenceCompat
            app:key="show_hidden"
            app:title="Show hidden files"
            app:summary="Show files starting with a dot (.)"
            app:defaultValue="false" />
        <SwitchPreferenceCompat
            app:key="dark_mode"
            app:title="Force Dark Mode"
            app:defaultValue="true" />
    </PreferenceCategory>
</PreferenceScreen>
